# ============================================
# VeriFy.AI - Environment Configuration
# ============================================
# 
# 🎮 DEMO MODE: Leave these empty to use demo mode with mock data
# 🚀 PRODUCTION: Fill in your actual API keys below
#

# ============================================
# Firebase Configuration (Optional - for real auth & database)
# Get these from: https://console.firebase.google.com/
# ============================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ============================================
# Gemini AI API (Required for real verification)
# Get from: https://makersuite.google.com/app/apikey
# ============================================
VITE_GEMINI_API_KEY=

# ============================================
# Optional APIs (Enhance verification with real data)
# ============================================

# NewsAPI - Get related articles
# Get from: https://newsapi.org/
VITE_NEWS_API_KEY=

# Google Fact Check API - Verify claims
# Get from: https://console.cloud.google.com/
VITE_GOOGLE_FACT_CHECK_API_KEY=

# ============================================
# Setup Instructions
# ============================================
# 
# 1. Copy this file to .env (it's gitignored)
# 2. Add your API keys above
# 3. Run: npm install && npm run dev
# 4. See README_FIREBASE_SETUP.md for detailed setup
#
